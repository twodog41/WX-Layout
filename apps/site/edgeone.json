{
  "name": "wx-layout",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @wx-layout/core build && pnpm --filter @wx-layout/ai-layout build && pnpm build",
  "outputDirectory": ".next",
  "nodeVersion": "22.11.0",
  "cloudFunctions": {
    "maxDuration": 120
  },
  "redirects": [
    {
      "source": "$wwwhost",
      "destination": "$host",
      "statusCode": 301
    }
  ]
}
