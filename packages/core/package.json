{
  "name": "@wx-layout/core",
  "version": "0.1.0",
  "description": "Deterministic Markdown to WeChat-compatible HTML renderer",
  "type": "module",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
